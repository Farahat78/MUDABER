# Environment Variables — Smart Salary App (Frontend)
# Copy to .env and fill in your values

# Optional: GitHub raw URL base for reading CSV data
# Format: https://raw.githubusercontent.com/YOUR_USERNAME/prediction-pipeline/main/data
DATA_GITHUB_RAW_BASE=https://raw.githubusercontent.com/YOUR_USERNAME/prediction-pipeline/main/data

# Optional: Google Generative AI key (used by Shopping NLP engine)
GOOGLE_API_KEY=your_google_api_key_here
